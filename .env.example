# Supabase Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real secrets to version control

# Next.js Public Variables (Client-side accessible)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — apex domain (no www). What the sitemap,
# JSON-LD, and OpenGraph canonical all emit. The www. variant
# is redirected to this in next.config.ts so SEO sees a single
# canonical. Used by src/lib/site-url.ts. Default fallback is
# 'https://studyinchina.academy' if unset.
NEXT_PUBLIC_SITE_URL=https://studyinchina.academy

# Server-side Only Variables (Do NOT expose to client)
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# Optional: Node environment
NODE_ENV=production

# AI provider for the chatbot and the admin "Generate university" tool.
# Set to "doubao" (default) or "deepseek". Only one provider is used at a
# time — fill in the matching env vars and leave the other empty.
AI_PROVIDER=doubao

# Doubao (豆包) API configuration (optional - for AI chat in production)
# Get your API key from https://console.volcengine.com/ark
# Create an endpoint first, then get your API key
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=ep-20241203153141-7jv9c # Replace with your endpoint ID

# DeepSeek API configuration (optional alternative to Doubao)
# Get your API key from https://platform.deepseek.com/api_keys
# Models: deepseek-chat (V3, default) | deepseek-reasoner (R1, slower but smarter)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Railway Specific Variables (auto-set by Railway)
# PORT=5000
# RAILWAY_STATIC_URL=
# RAILWAY_PUBLIC_DOMAIN=

# === Admin invite token (gate /admin/register) ===
# Generate with: openssl rand -hex 32
# Share the resulting URL only with intended admins: /admin/register?token=<value>
# Leave empty to fully disable admin self-registration.
ADMIN_INVITE_TOKEN=

# === Resend email notifications (admin alerts + lead drip sequence) ===
# Get your API key from https://resend.com
# Leave empty to disable email notifications (submission still works)
RESEND_API_KEY=
ADMIN_EMAIL=admin@sica.cn

# Optional: shared secret to protect /api/email/drip-cron from
# unauthorized external triggers. If unset, the endpoint is open
# (fine for low-traffic deploys). Recommended for production.
DRIP_CRON_SECRET=

# === Google Analytics 4 ===
# Your GA4 Measurement ID (looks like G-XXXXXXXXXX). Get it from
# https://analytics.google.com → Admin → Data Streams → your stream.
# Leave empty to fully disable GA (no script tag fires, no events
# are sent). The @next/third-parties/google <GoogleAnalytics>
# component in src/app/layout.tsx is env-gated — set this to go
# live. Custom events are fired via src/lib/analytics.ts (typed
# wrappers around sendGAEvent). See the AnalyticsEventMap there
# for the full event catalog.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === Sentry error monitoring (Phase 34) ===
# DSN from your Sentry project → Settings → Client Keys (DSN).
# The same DSN is used for server + edge + browser init — keep it
# server-only in process.env (don't prefix with NEXT_PUBLIC_).
# Leave empty to fully disable Sentry (no SDK init, no build-time
# wrapping, no source-map upload — matches Phase 29 GA4 pattern).
# - Server + edge init: src/instrumentation.ts (gated on the DSN)
# - Browser init: src/instrumentation-client.ts (gated on DSN + window)
# - Build-time wrapping: next.config.ts (gated on the DSN)
# - /api/health reports `checks.env.SENTRY_DSN=true|false` so the
#   uptime monitor can confirm the env reached the runtime.
SENTRY_DSN=

# Optional. Defaults to 0.1 (10% of transactions shipped). Lower to
# stretch free-tier quota; 0 to ship errors-only.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional. Only needed when source-map upload is set up. SICA
# doesn't run sentry-cli yet — leave empty. See Sentry docs →
# Auth Tokens for setup.
SENTRY_ORG=
SENTRY_PROJECT=

# === Shared secret to protect /api/cron/generate-news from
# unauthorized external triggers. If unset, the endpoint is open
# (fine for low-traffic dev). Recommended for production.
NEWS_CRON_SECRET=
