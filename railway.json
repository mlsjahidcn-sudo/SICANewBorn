{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "pnpm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  },
  "plugins": [],
  "env": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SUPABASE_URL": {
      "description": "Supabase项目URL",
      "required": true
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "description": "Supabase匿名访问密钥",
      "required": true
    },
    "COZE_SUPABASE_URL": {
      "description": "Supabase项目URL（服务器端）",
      "required": true
    },
    "COZE_SUPABASE_ANON_KEY": {
      "description": "Supabase匿名访问密钥（服务器端）",
      "required": true
    },
    "COZE_SUPABASE_SERVICE_ROLE_KEY": {
      "description": "Supabase服务角色密钥（仅服务器端使用）",
      "required": true
    }
  }
}
