loglevel=error
registry=https://registry.npmmirror.com

strictStorePkgContentCheck=false
verifyStoreIntegrity=false

# 网络优化
network-concurrency=16
fetch-retries=3
fetch-timeout=60000

# 严格使用 peer dependencies
strict-peer-dependencies=false

# 自动生成 lockfile
auto-install-peers=true

# lockfile 配置
lockfile=true
prefer-frozen-lockfile=true

# 如果 lockfile 存在但过期，更新而不是失败
resolution-mode=highest

# 不提示 npm 更新
update-notifier=false

# pnpm 11+ (S59): the safe-by-default ignored-builds check now exits
# with code 1 when ANY package has an unapproved postinstall script.
# SICA needs 5 specific packages' postinstall hooks (sharp for native
# image-processing binaries, esbuild for its binary, etc.). The
# allowlist lives in pnpm-workspace.yaml (pnpm 11 removed the
# package.json#pnpm.onlyBuiltDependencies location). The SICA dep tree
# is fully audited via pnpm-lock.yaml's integrity hashes. After adding
# a new dep with a postinstall, re-run `pnpm install` and add any
# newly-flagged package to the pnpm-workspace.yaml list.
