registry=https://registry.npmmirror.com

# SICA dep tree (Sentry, Next 16, Supabase, etc.) has several
# transitive-peer mismatches that npm 10/11 refuse to install
# by default. `legacy-peer-deps=true` matches the behavior npm 6-7
# had — install everything, log a warning, don't fail. The
# package-lock.json integrity hashes still gate the supply chain.
legacy-peer-deps=true
